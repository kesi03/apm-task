{
  "manifestVersion": 1,
  "id": "ci-apm-trace",
  "name": "CI APM Trace",
  "version": "1.1.3",
  "publisher": "Mockholm",
  "description": "Sends CI pipeline traces to Elastic APM",
  "galleryFlags": [
    "Public"
  ],
  "categories": [
    "Azure Pipelines"
  ],
  "tags": [
    "elastic",
    "apm",
    "trace",
    "monitoring",
    "ci",
    "service-connection"
  ],
  "icons": {
    "default": "icons/128.png"
  },
  "files": [
    {
      "path": "CiApmTrace"
    }
  ],
  "content": {
    "details": {
      "path": "overview.md"
    }
  },
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "contributions": [
    {
      "id": "CiApmTrace",
      "type": "ms.vss-distributed-task.task",
      "targets": [
        "ms.vss-distributed-task.tasks"
      ],
      "properties": {
        "name": "CiApmTrace"
      }
    },
    {
      "id": "apm-service-endpoint",
      "description": "Elastic APM service connection",
      "type": "ms.vss-endpoint.service-endpoint-type",
      "targets": [
        "ms.vss-endpoint.endpoint-types"
      ],
      "properties": {
        "name": "apm",
        "displayName": "Elastic APM",
        "description": "Connection to an Elastic APM Server",
        "url": {
          "displayName": "APM Server URL",
          "helpText": "URL of your Elastic APM Server, e.g. https://apm.example.com:8200"
        },
        "authenticationSchemes": [
          {
            "type": "ms.vss-endpoint.endpoint-auth-scheme-token",
            "headers": [
              {
                "name": "Authorization",
                "value": "Bearer {{endpoint.apitoken}}"
              }
            ],
            "inputDescriptors": [
              {
                "id": "apitoken",
                "name": "APM Secret Token",
                "description": "Secret token used to authenticate with the APM Server",
                "inputMode": "passwordbox",
                "isConfidential": true,
                "validation": {
                  "isRequired": false,
                  "dataType": "string"
                }
              }
            ]
          }
        ],
        "helpMarkDown": "Enter the URL and secret token of your Elastic APM Server. The secret token can be left blank if the APM Server is configured without authentication."
      }
    }
  ]
}
